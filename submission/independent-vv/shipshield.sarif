          "rules": [
            {
              "id": "dep-vuln",
              "name": "depVuln",
              "shortDescription": {
                "text": "Vulnerable dependency: dompurify 3.2.4 (GHSA-39q2-94rc-95cp)"
              },
              "fullDescription": {
                "text": "DOMPurify's ADD_TAGS function form bypasses FORBID_TAGS due to short-circuit evaluation"
              },
              "help": {
                "text": "Upgrade dompurify from 3.2.4 to version 3.4.0 or later. Update the lockfile, run the tests, and tell me about any breaking changes in the release notes. Advisory: https://osv.dev/vulnerability/GHSA-39q2-94rc-95cp"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "external/cwe/cwe-783"
                ]
              }
            }
          ]
        }
      },
